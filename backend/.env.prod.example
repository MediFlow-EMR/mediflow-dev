SPRING_PROFILES_ACTIVE=prod,demo
SERVER_PORT=9005

DB_HOST=REPLACE_RDS_ENDPOINT
DB_PORT=3306
DB_NAME=mediflowdb
DB_USERNAME=mediflow_app
DB_PASSWORD=REPLACE_STRONG_PASSWORD
DB_SSL_MODE=verify-full
DB_SSL_CERT=/etc/pki/tls/certs/rds-global-bundle.pem
JPA_DDL_AUTO=update

# Generate a Base64-encoded signing key: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_KEY
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

COOKIE_DOMAIN=.mediflow-emr.cloud
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://mediflow-emr.cloud,https://www.mediflow-emr.cloud
OAUTH2_SUCCESS_REDIRECT_URL=https://www.mediflow-emr.cloud/app
OAUTH2_FAILURE_REDIRECT_URL=https://www.mediflow-emr.cloud/auth/signin?from=oauth2

GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
GOOGLE_REDIRECT_URI=https://api.mediflow-emr.cloud/login/oauth2/code/google
KAKAO_CLIENT_ID=REPLACE
KAKAO_CLIENT_SECRET=REPLACE
KAKAO_REDIRECT_URI=https://api.mediflow-emr.cloud/login/oauth2/code/kakao

MAIL_USERNAME=REPLACE
MAIL_PASSWORD=REPLACE
DRUG_API_SERVICE_KEY=REPLACE
GEMINI_API_KEY=REPLACE_NEW_KEY
GEMINI_MODEL=gemini-2.5-flash
